# Copia este fichero a .env.local y ajusta el valor.
# Sin barra final.
NEXT_PUBLIC_WORDPRESS_URL=https://staging.aguafy.com

# Dominio público de la tienda, sin barra final. Se usa para el canonical
# y otros enlaces absolutos. En local puede omitirse (localhost:3000).
NEXT_PUBLIC_SITE_URL=https://aguafy.com

# Secreto compartido con WordPress para el registro de usuarios.
# Tiene que valer lo mismo que REACTAFY_SERVER_SECRET en wp-config.php.
# SIN el prefijo NEXT_PUBLIC_: no debe llegar nunca al navegador.
# Genera uno con: openssl rand -hex 32
WORDPRESS_SECRET=
