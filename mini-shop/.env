# Valores comunes a todos los modos. `.env.production` los sobrescribe
# en el build.
#
# Estas dos variables las leen DOS sitios que tienen que coincidir
# exactamente: el <link rel="preload"> de index.html y el fetch que
# hace la app. Si divergen, el navegador no reconoce la respuesta
# precargada y descarga dos veces.

# En dev apunta al proxy de Vite (ver vite.config.ts).
VITE_API_BASE=/api

# Productos por página. Lo usan Shop.tsx y el preload del index.html.
VITE_PRODUCTS_PER_PAGE=20
