# Base de la API para el build de producción.
#
# El proxy `/api` de Vite solo existe en dev y preview: una vez
# desplegado hay que apuntar al host real de WordPress.
#
# Cambia a https://aguafy.com para medir contra producción.
VITE_API_BASE=https://staging.aguafy.com

# Tiene que coincidir con el `perPage` del preload en index.html,
# que se genera a partir de esta misma variable.
VITE_PRODUCTS_PER_PAGE=20
